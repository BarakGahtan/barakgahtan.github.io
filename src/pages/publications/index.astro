---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PubEntry from '../../components/PubEntry.astro';
import { linkAttrs } from '../../lib/site';

const pubs = (await getCollection('publications')).sort((a, b) => b.data.order - a.data.order);
const published = pubs.filter((p) => p.data.status === 'published');
const preprints = pubs.filter((p) => p.data.status !== 'published');
const scholar = 'https://scholar.google.com/citations?user=Uph8rcwAAAAJ&hl=en&oi=ao';
---

<Base title="Publications" description="Publications by Barak Gahtan, with summaries and links to arXiv, publisher pages and PDFs." wide>
  <div class="page-head">
    <p class="eyebrow">Publications</p>
    <h1>Publications</h1>
    <p class="lede">Peer-reviewed papers first, then preprints and papers under review, each with a short summary. Also on <a href={scholar} {...linkAttrs(scholar)}>Google Scholar</a>.</p>
  </div>

  <section class="section">
    <div class="section-head"><h2>Peer-reviewed</h2><span class="meta">{published.length} papers</span></div>
    <ul class="pub-list">{published.map((p) => <PubEntry pub={p} />)}</ul>
  </section>

  <section class="section">
    <div class="section-head"><h2>Preprints and papers under review</h2><span class="meta">{preprints.length} papers</span></div>
    <ul class="pub-list">{preprints.map((p) => <PubEntry pub={p} />)}</ul>
  </section>
</Base>
